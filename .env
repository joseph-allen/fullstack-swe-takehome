# normally this would be a managed secret, but for a tech test it's comitted
# Mongo credentials
MONGO_USERNAME=root
MONGO_PASSWORD=example

# Mongo URI for app, backend, db-init
MONGODB_URI=mongodb://${MONGO_USERNAME}:${MONGO_PASSWORD}@mongodb:27017/my-db?authSource=admin

# Backend API
BACKEND_URL=http://backend:4000
